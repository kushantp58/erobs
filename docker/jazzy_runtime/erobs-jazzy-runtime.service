[Unit]
Description=EROBS ROS 2 Jazzy Runtime Container Service (Podman)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=30

# Configuration variables (override via `systemctl edit erobs-jazzy-runtime.service`)
Environment="CONTAINER_NAME=beambot_ros"
Environment="IMAGE=localhost/erobs-jazzy-runtime:latest"
Environment="BEAMBOT_BEAMLINE_CONFIG=/root/ws/erobs/src/beambot/config/example_cms_beamline.yaml"


Environment="LAUNCH_ARGS=enable_vision:=false enable_pipettor:=false"
# Environment="ROS_DISCOVERY_SERVER=ros1.nsls2.bnl.gov:11811;ros2.nsls2.bnl.gov:11888"
# Environment="FASTDDS_BUILTIN_TRANSPORTS=UDPv4"

# Clean up any leftover container with the same name
ExecStartPre=-/usr/bin/podman rm -f --ignore ${CONTAINER_NAME}

# Start the container 
ExecStart=/usr/bin/podman run --rm --replace \
    --name ${CONTAINER_NAME} \
    --network host \
    --ipc=host \
    --pid=host \
    -e BEAMBOT_BEAMLINE_CONFIG=${BEAMBOT_BEAMLINE_CONFIG} \
    ${IMAGE} \
    $LAUNCH_ARGS

# Gracefully stop and clean up the container
ExecStop=/usr/bin/podman stop --ignore -t 20 ${CONTAINER_NAME}
ExecStopPost=-/usr/bin/podman rm -f --ignore ${CONTAINER_NAME}

[Install]
WantedBy=default.target

