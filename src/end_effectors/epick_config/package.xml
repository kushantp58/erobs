<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>epick_config</name>
  <version>0.1.0</version>
  <description>ePick overlay xacro (mounting pose, serial port) and suction-cup profiles.</description>
  <maintainer email="abondada@bnl.gov">Aditya Bondada</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>epick_description</exec_depend>
  <exec_depend>epick_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>